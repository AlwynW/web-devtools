<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Avoid rewriting the actual index.html file
  RewriteRule ^index\.html$ - [L]

  # Missing hashed assets must 404. Rewriting them to index.html makes the
  # browser parse HTML as a module after a deploy removes an old chunk.
  RewriteCond %{REQUEST_URI} ^/assets/ [OR]
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|json|svg|png|jpe?g|webp|gif|ico|woff2?|ttf)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [END]

  # SPA: non-file requests fall back to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"

  # Hashed build assets: long-cache immutable
  <FilesMatch "\.(js|mjs|css|map|svg|png|jpe?g|webp|gif|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Service worker + Workbox runtime must revalidate so updates install.
  <FilesMatch "^(sw\.js|workbox-.*\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # HTML entry must revalidate so clients discover new SW revisions.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Unhashed home-screen and tab icons must be replaceable.
  <FilesMatch "^(favicon.*|apple-touch-icon.*|icon-.*\.png)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
